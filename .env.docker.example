# LOCAL ONLY: reemplaza credenciales y JWT_SECRET antes de usar datos reales.
# Docker Compose configura los hosts internos de PostgreSQL/Redis y las URLs de servicios.
POSTGRES_DB=gym_db
POSTGRES_USER=gym_user
POSTGRES_PASSWORD=gym_password
REDIS_PASSWORD=
# LOCAL ONLY; generate a private value before handling real data.
JWT_SECRET=local-only-change-this-secret-before-sharing
CORS_ORIGIN=http://localhost:5173
