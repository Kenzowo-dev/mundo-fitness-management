# Database (Docker internal)
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=gym_db
POSTGRES_USER=gym_user
POSTGRES_PASSWORD=gym_password

# Redis (Docker internal)
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# JWT (required, no default)
JWT_SECRET=
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# CORS
CORS_ORIGIN=http://localhost:5173

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Service URLs (for API Gateway - Docker internal)
AUTH_SERVICE_URL=http://auth-service:3001
CLIENT_SERVICE_URL=http://client-service:3002
MEMBERSHIP_SERVICE_URL=http://membership-service:3003
PAYMENT_SERVICE_URL=http://payment-service:3004
PLAN_SERVICE_URL=http://plan-service:3005
REPORT_SERVICE_URL=http://report-service:3006

# Frontend (host accessible)
VITE_API_URL=http://localhost:3000