# LOCAL ONLY: values below are for a disposable local development environment.
# Replace credentials and JWT_SECRET before using real or non-demo data.
# Database (Node local; Compose overrides the host to its service name)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=gym_db
POSTGRES_USER=gym_user
POSTGRES_PASSWORD=gym_password

# Redis (Node local; Compose overrides the host to its service name)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# LOCAL ONLY. Replace before using non-demo data.
JWT_SECRET=local-only-change-this-secret-before-sharing
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# CORS
CORS_ORIGIN=http://localhost:5173

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Service URLs (Node local; Compose overrides them inside its network)
AUTH_SERVICE_URL=http://localhost:3001
CLIENT_SERVICE_URL=http://localhost:3002
MEMBERSHIP_SERVICE_URL=http://localhost:3003
PAYMENT_SERVICE_URL=http://localhost:3004

# Frontend (host accessible)
VITE_API_URL=http://localhost:3000
