# LOCAL ONLY: para Node ejecutado en el host + PostgreSQL/Redis en Docker.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=gym_db
POSTGRES_USER=gym_user
POSTGRES_PASSWORD=gym_password
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
# LOCAL ONLY; generate a private value before handling real data.
JWT_SECRET=local-only-change-this-secret-before-sharing
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
CORS_ORIGIN=http://localhost:5173
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
AUTH_SERVICE_URL=http://localhost:3001
CLIENT_SERVICE_URL=http://localhost:3002
MEMBERSHIP_SERVICE_URL=http://localhost:3003
PAYMENT_SERVICE_URL=http://localhost:3004
VITE_API_URL=http://localhost:3000
